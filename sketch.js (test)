function setup() {
  createCanvas(400, 400);
  colorMode(HSB, 360, 100, 100);
}

function draw() {
  background(0, 0, 8);
  noStroke();

  const hueShift = frameCount * 0.25;
  const squares = [
    { x: 30, y: 30, size: 340, hue: 5 },
    { x: 65, y: 75, size: 260, hue: 35 },
    { x: 105, y: 115, size: 190, hue: 55 },
    { x: 145, y: 150, size: 120, hue: 80 }
  ];

  for (const layer of squares) {
    fill((layer.hue + hueShift) % 360, 75, 95);
    square(layer.x, layer.y, layer.size);
  }
}